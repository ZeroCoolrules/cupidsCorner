# Copy this file to .env and fill in the credentials for whichever
# optional integrations you want. Everything below is optional — the app
# runs fine with none of it configured.

# Stream (video calling + chat) — https://dashboard.getstream.io
STREAM_API_KEY=
STREAM_API_SECRET=

# Stripe (buy sparks with real money) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cupid AI — point at any OpenAI-compatible chat completions endpoint to
# use a real model instead of the built-in heuristic.
CUPID_LLM_URL=
CUPID_LLM_KEY=
CUPID_LLM_MODEL=

# x402 paid endpoint: POST /match/compatibility (pay-per-call in USDC).
# Disabled until X402_PAY_TO is set. Defaults to Base mainnet at $0.001.
X402_PAY_TO=
X402_PRICE=$0.001
# eip155:8453 = Base mainnet, eip155:84532 = Base Sepolia (test)
X402_NETWORK=eip155:8453
# Public origin of the deployed app (no trailing slash); used as the 402 resource URL
X402_PUBLIC_URL=
# Coinbase CDP API key (https://portal.cdp.coinbase.com). Needed for the CDP
# facilitator, the only one that lists endpoints in the CDP Bazaar.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Only used when no CDP key is set (x402.org is testnet-only and NOT cataloged)
X402_FACILITATOR_URL=https://x402.org/facilitator

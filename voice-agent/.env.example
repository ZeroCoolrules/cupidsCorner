# LiveKit project (Settings > API keys in LiveKit Cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The Cupid's Corner backend and the shared secret. The secret must be the
# same value as COACH_AGENT_SECRET on the backend (Render).
COACH_BACKEND_URL=https://cupids-corner.onrender.com
COACH_AGENT_SECRET=

# Optional. Name used in the LiveKit dispatch rule for the coach line.
COACH_AGENT_NAME=cupid-coach
# Optional. Models served through LiveKit Inference (billed to your LiveKit project).
COACH_STT_MODEL=deepgram/nova-3
COACH_LLM_MODEL=openai/gpt-4.1-mini
COACH_TTS_MODEL=cartesia/sonic-3
# Optional. A voice id for the TTS model above. Empty uses the model's default voice.
COACH_TTS_VOICE=
